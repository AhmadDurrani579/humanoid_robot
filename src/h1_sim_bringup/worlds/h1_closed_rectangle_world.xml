<mujoco model="H1 Closed Rectangle SLAM and Nav2 World">

  <include file="h1.xml"/>

  <statistic center="15 6 1.5" extent="24"/>

  <visual>
    <headlight
      diffuse="0.65 0.65 0.65"
      ambient="0.25 0.25 0.25"
      specular="0.60 0.60 0.60"
    />
    <rgba haze="0.12 0.15 0.20 1"/>
    <global azimuth="-125" elevation="-32"/>
  </visual>

  <asset>
    <texture
      type="skybox"
      builtin="gradient"
      rgb1="0.24 0.38 0.55"
      rgb2="0.04 0.05 0.08"
      width="512"
      height="3072"
    />

    <texture
      type="2d"
      name="floor_texture"
      builtin="checker"
      rgb1="0.32 0.34 0.37"
      rgb2="0.40 0.42 0.45"
      mark="edge"
      markrgb="0.48 0.50 0.53"
      width="1024"
      height="1024"
    />

    <material
      name="floor_material"
      texture="floor_texture"
      texuniform="true"
      texrepeat="24 14"
      reflectance="0.05"
    />
  </asset>

  <worldbody>

    <!-- ===================================================== -->
    <!-- Lighting                                               -->
    <!-- ===================================================== -->

    <light
      pos="15 6 14"
      dir="0 0 -1"
      directional="true"
      diffuse="0.80 0.82 0.86"
    />

    <light
      pos="5 2 8"
      dir="0 0 -1"
      diffuse="0.50 0.52 0.56"
    />

    <light
      pos="25 10 8"
      dir="0 0 -1"
      diffuse="0.50 0.52 0.56"
    />

    <!-- ===================================================== -->
    <!-- Floor                                                  -->
    <!-- ===================================================== -->

    <geom
      name="main_floor"
      type="plane"
      size="40 30 0.05"
      material="floor_material"
      friction="1.0 0.1 0.1"
    />

    <!-- ===================================================== -->
    <!-- Outer closed walls                                     -->
    <!-- Outer boundary: x=-3 to 33, y=-3 to 15                -->
    <!-- ===================================================== -->

    <geom
      name="outer_wall_south"
      type="box"
      pos="15 -3.0 1.5"
      size="18.0 0.20 1.5"
      rgba="0.77 0.80 0.85 1"
    />

    <geom
      name="outer_wall_north"
      type="box"
      pos="15 15.0 1.5"
      size="18.0 0.20 1.5"
      rgba="0.77 0.80 0.85 1"
    />

    <geom
      name="outer_wall_west"
      type="box"
      pos="-3.0 6.0 1.5"
      size="0.20 9.0 1.5"
      rgba="0.77 0.80 0.85 1"
    />

    <geom
      name="outer_wall_east"
      type="box"
      pos="33.0 6.0 1.5"
      size="0.20 9.0 1.5"
      rgba="0.77 0.80 0.85 1"
    />

    <!-- ===================================================== -->
    <!-- Inner closed island walls                              -->
    <!-- Creates a continuous rectangular corridor loop         -->
    <!-- Inner boundary: x=3 to 27, y=3 to 9                    -->
    <!-- ===================================================== -->

    <geom
      name="inner_wall_south"
      type="box"
      pos="15.0 3.0 1.5"
      size="12.0 0.20 1.5"
      rgba="0.64 0.69 0.76 1"
    />

    <geom
      name="inner_wall_north"
      type="box"
      pos="15.0 9.0 1.5"
      size="12.0 0.20 1.5"
      rgba="0.64 0.69 0.76 1"
    />

    <geom
      name="inner_wall_west"
      type="box"
      pos="3.0 6.0 1.5"
      size="0.20 3.0 1.5"
      rgba="0.64 0.69 0.76 1"
    />

    <geom
      name="inner_wall_east"
      type="box"
      pos="27.0 6.0 1.5"
      size="0.20 3.0 1.5"
      rgba="0.64 0.69 0.76 1"
    />

    <!-- ===================================================== -->
    <!-- Inner island floor                                     -->
    <!-- Non-colliding visual surface                           -->
    <!-- ===================================================== -->

    <geom
      name="inner_island_floor"
      type="box"
      pos="15.0 6.0 0.015"
      size="11.8 2.8 0.015"
      rgba="0.18 0.22 0.27 1"
      contype="0"
      conaffinity="0"
    />

    <!-- ===================================================== -->
    <!-- SLAM landmarks                                         -->
    <!-- Different shapes help scan matching and loop closure   -->
    <!-- These are positioned near walls, not in route centre   -->
    <!-- ===================================================== -->

    <geom
      name="landmark_cylinder_southwest"
      type="cylinder"
      pos="5.0 -1.9 0.8"
      size="0.45 0.8"
      rgba="0.92 0.42 0.12 1"
    />

    <geom
      name="landmark_box_southeast"
      type="box"
      pos="25.0 -1.9 0.75"
      size="0.55 0.55 0.75"
      rgba="0.12 0.48 0.88 1"
    />

    <geom
      name="landmark_cylinder_northeast"
      type="cylinder"
      pos="29.8 13.7 0.9"
      size="0.50 0.9"
      rgba="0.20 0.72 0.36 1"
    />

    <geom
      name="landmark_box_northwest"
      type="box"
      pos="0.0 13.7 0.8"
      size="0.60 0.45 0.8"
      rgba="0.72 0.24 0.68 1"
    />

    <!-- ===================================================== -->
    <!-- Fixed obstacle tests                                   -->
    <!-- Positioned toward corridor edges, leaving safe space   -->
    <!-- ===================================================== -->

    <!-- Bottom corridor obstacle -->
    <geom
      name="obstacle_bottom_box"
      type="box"
      pos="13.0 1.45 0.65"
      size="0.55 0.55 0.65"
      rgba="0.90 0.18 0.15 1"
    />

    <!-- Right corridor obstacle -->
    <geom
      name="obstacle_right_cylinder"
      type="cylinder"
      pos="28.7 6.3 0.65"
      size="0.50 0.65"
      rgba="0.12 0.58 0.88 1"
    />

    <!-- Top corridor obstacle -->
    <geom
      name="obstacle_top_box"
      type="box"
      pos="19.0 10.55 0.65"
      size="0.55 0.55 0.65"
      rgba="0.16 0.72 0.34 1"
    />

    <!-- Left corridor obstacle -->
    <geom
      name="obstacle_left_cylinder"
      type="cylinder"
      pos="1.4 6.0 0.65"
      size="0.45 0.65"
      rgba="0.92 0.62 0.10 1"
    />

    <!-- ===================================================== -->
    <!-- Visual waypoint markers                                -->
    <!-- Non-colliding                                          -->
    <!-- ===================================================== -->

    <geom
      name="marker_start"
      type="sphere"
      pos="3.0 0.0 0.08"
      size="0.16"
      rgba="0.10 1.00 0.30 0.90"
      contype="0"
      conaffinity="0"
    />

    <geom
      name="marker_bottom_middle"
      type="sphere"
      pos="15.0 0.0 0.08"
      size="0.14"
      rgba="0.00 0.80 1.00 0.85"
      contype="0"
      conaffinity="0"
    />

    <geom
      name="marker_bottom_right"
      type="sphere"
      pos="26.0 0.0 0.08"
      size="0.14"
      rgba="0.00 0.80 1.00 0.85"
      contype="0"
      conaffinity="0"
    />

    <geom
      name="marker_right_middle"
      type="sphere"
      pos="30.0 6.0 0.08"
      size="0.14"
      rgba="1.00 0.48 0.10 0.85"
      contype="0"
      conaffinity="0"
    />

    <geom
      name="marker_top_right"
      type="sphere"
      pos="26.5 12.0 0.08"
      size="0.14"
      rgba="0.75 0.25 1.00 0.85"
      contype="0"
      conaffinity="0"
    />

    <geom
      name="marker_top_middle"
