      pos="3.0 12.0 0.08"
      size="0.14"
      rgba="1.00 0.85 0.10 0.85"
      contype="0"
      conaffinity="0"
    />

    <geom
      name="marker_left_middle"
      type="sphere"
      pos="0.0 6.0 0.08"
      size="0.14"
      rgba="1.00 0.50 0.10 0.85"
      contype="0"
      conaffinity="0"
    />

    <!-- ===================================================== -->
    <!-- Ceiling-style visual strips                            -->
    <!-- Non-colliding                                          -->
    <!-- ===================================================== -->

    <geom
      name="light_strip_bottom"
